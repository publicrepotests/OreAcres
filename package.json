    "test:social-server": "node scripts/check-rpg-social-server.mjs",
    "test:activities": "node scripts/check-rpg-activity-rules.mjs",
    "test:admin": "node scripts/check-rpg-admin-server.mjs",
    "test:loot": "node scripts/check-rpg-loot-rules.mjs",
