    "test:ambience": "node scripts/check-rpg-world-ambience.mjs",
    "test:world-time": "node --experimental-strip-types scripts/check-rpg-world-time.mjs",
    "test:quests": "node scripts/check-rpg-quest-rules.mjs",
    "test:side-quests": "node --experimental-strip-types scripts/check-rpg-side-quests.mjs",
    "test:profiles": "node scripts/check-rpg-profile-store.mjs",
    "test:auth-server": "node scripts/check-rpg-authenticated-server.mjs",
    "test:world-event": "node scripts/check-rpg-world-event-server.mjs",
    "test:public-events": "node --experimental-strip-types scripts/check-rpg-public-events.mjs",
    "test:world-guidance": "node --experimental-strip-types scripts/check-rpg-world-guidance.mjs",
    "test:audiovisual": "node scripts/check-rpg-audiovisual-assets.mjs",
