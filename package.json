    "test:portraits": "node scripts/check-rpg-portrait-assets.mjs",
    "test:tutorial": "node --experimental-strip-types scripts/check-rpg-tutorial.mjs",
    "test:rpg": "npm run test:world && npm run test:ambience && npm run test:world-time && npm run test:quests && npm run test:side-quests && npm run test:world-guidance && npm run test:audiovisual && npm run test:catacombs && npm run test:catacomb-server && npm run test:catacomb-rules && npm run test:activities && npm run test:adventures && npm run test:rare-encounters && npm run test:public-events && npm run test:loot && npm run test:characters && npm run test:portraits && npm run test:tutorial && npm run test:progression && npm run test:hitpoints && npm run test:recovery && npm run test:profiles && npm run test:combat-server && npm run test:combat-ui && npm run test:interactions && npm run test:skill-tree && npm run test:social-server && npm run test:world-event && npm run test:auth-server && npm run test:admin"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "2.111.0",
